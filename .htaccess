# Home State Inspections - Apache config.
#
# NOTE: GitHub Pages, where the site is hosted today, ignores this file completely.
# It only takes effect on ordinary Apache hosting such as a cPanel plan. Kept because
# it is written and correct, and would apply the moment the site moved to such a host.
#
# It does four jobs: forces HTTPS, settles on one canonical hostname, sets cache
# headers, and blocks the repo internal files from being served.


# ---------------------------------------------------------------------------
# 1. HTTPS, and one canonical hostname
#
# Every page's <link rel="canonical"> and every URL in sitemap.xml uses the bare
# domain with no www, so www redirects to the apex to match. Two hostnames both
# serving the same pages splits search ranking between them.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>


# ---------------------------------------------------------------------------
# 2. Cache headers
#
# This is the part GitHub Pages would not allow, and the reason pages kept
# needing a manual refresh: Pages served HTML with a fixed ten-minute cache, so
# a visitor could keep getting a stale page well after a change went up.
#
# HTML now revalidates on every request. That is not the same as "no caching" -
# the browser still holds the file, it just asks whether it changed first, and
# gets a small 304 back when it has not. Changes appear immediately.
#
# CSS and JS are safe to cache hard because the markup requests them with a
# ?v=N query that gets bumped whenever either file changes.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>


# ---------------------------------------------------------------------------
# 3. Keep the repo's internal files out of the public site
#
# README.md, HANDOFF.md and LAUNCH-CHECKLIST.md are written for Boaz and his
# brother-in-law. They record that the service photos are stock, that the
# InterNACHI membership is not active yet, and that the Google Business Profile
# is not set up - none of which should be readable at
# homestateinspects.com/HANDOFF.md. Better not to upload them at all, but this
# is the backstop if they ever end up in public_html.
# ---------------------------------------------------------------------------
RedirectMatch 404 (?i)\.(md|ps1|sh|bak|log|zip)$
RedirectMatch 404 (?i)^/tools/
RedirectMatch 404 (?i)^/logo-source\.


# ---------------------------------------------------------------------------
# 4. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml image/svg+xml
</IfModule>


# ---------------------------------------------------------------------------
# 5. Friendly error page
#
# Without this Apache serves its own bare "Not Found" page, which looks broken
# next to the rest of the site.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html
